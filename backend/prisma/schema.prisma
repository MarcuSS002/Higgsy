generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  password     String
  avatars      Avatar[]
  avatarVideos AvatarVideo[]
}

model Avatar {
  id                    String                 @id @default(uuid())
  userId                String
  name                  String

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarImages          AvatarImage[]
  avatarVideoReferences AvatarVideoReference[]
}

model AvatarImage {
  id                 String          @id @default(uuid())
  avatarId           String
  type               AvatarImageType
  url                String
  cloudinaryPublicId String

  avatar Avatar @relation(fields: [avatarId], references: [id], onDelete: Cascade)
}

model AvatarVideo {
  id                    String                 @id @default(uuid())
  userId                String
  prompt                String
  startFrame            String?
  endFrame              String?
  duration              Int
  width                 Int
  height                Int
  status                AvatarVideoStatus

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarVideoReferences AvatarVideoReference[]
}

model AvatarVideoReference {
  id            String      @id @default(uuid())
  avatarVideoId String
  avatarId      String

  avatar        Avatar      @relation(fields: [avatarId], references: [id], onDelete: Cascade)
  avatarVideo   AvatarVideo @relation(fields: [avatarVideoId], references: [id], onDelete: Cascade)
}

enum AvatarImageType {
  User
  Model
}

enum AvatarVideoStatus {
  Pending
  Done
  Error
}